<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- <xacro:include filename="inertial_macros.xacro"/> -->
    <!-- <xacro:include filename="robot_materials.xacro"/>-->

    <xacro:macro name="inertial_sphere" params="mass radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(2/5) * mass * (radius*radius)}" ixy="0.0" ixz="0.0"
                    iyy="${(2/5) * mass * (radius*radius)}" iyz="0.0"
                    izz="${(2/5) * mass * (radius*radius)}" />
        </inertial>
    </xacro:macro>  


    <xacro:macro name="inertial_box" params="mass x y z *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (y*y+z*z)}" ixy="0.0" ixz="0.0"
                    iyy="${(1/12) * mass * (x*x+z*z)}" iyz="0.0"
                    izz="${(1/12) * mass * (x*x+y*y)}" />
        </inertial>
    </xacro:macro>


    <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
                    iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
                    izz="${(1/2) * mass * (radius*radius)}" />
        </inertial>
    </xacro:macro>

    <material name="blue">
      <color rgba="0 0 1 1"/>  <!-- Blue color -->
    </material>

    <material name="white">
      <color rgba="1 1 1 1"/>  <!-- White color -->
    </material>

    <!-- BASE LINK -->
    <link name="base_link">
    </link>

    <!-- CHASSIS LINK -->
    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis" />
        <origin xyz="-0.3 0 0"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0.75 0 0.35"/>
            <geometry>
                <box size="1.5 0.9 0.7"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0.75 0 0.35"/>
            <geometry>
                <box size="1.5 0.9 0.7"/>
            </geometry>
            <material name="white"/>
        </collision>
        <xacro:inertial_box mass="20" x= "1.5" y="0.9" z="0.7">
            <origin xyz="0.75 0 0.35"/>
        </xacro:inertial_box>
    </link>

    <!-- LEFT BACK WHEEL LINK -->
    <joint name="left_back_wheel_joint" type="continuous">
        <origin xyz="0 0.5 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <parent link="base_link" />
        <child link="left_back_wheel" />
    </joint>

    <link name="left_back_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.2" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.2" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </collision>
        <xacro:inertial_cylinder mass="1" length="0.1" radius="0.2">
            <origin xyz="0 0 0" rpy= "0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- RIGHT BACK WHEEL LINK -->
    <joint name="right_back_wheel_joint" type="continuous">
        <origin xyz="0 -0.5 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <parent link="base_link" />
        <child link="right_back_wheel" />
    </joint>

    <link name="right_back_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.2" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.2" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </collision>
         <xacro:inertial_cylinder mass="1" length="0.1" radius="0.2">
            <origin xyz="0 0 0" rpy= "0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- LEFT FRONT WHEEL LINK (Steering) -->
    <joint name="left_front_wheel_joint" type="revolute">
        <origin xyz="1.0 0.45 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <parent link="chassis"/>
        <child link="left_front_wheel"/>
        <limit effort="10" velocity="1.0" lower="-0.5" upper="0.5"/>
    </joint>

    <link name="left_front_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.2" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.2" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </collision>
        <xacro:inertial_cylinder mass="1" length="0.1" radius="0.2">
            <origin xyz="0 0 0" rpy= "0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- RIGHT FRONT WHEEL LINK (Steering) -->
    <joint name="right_front_wheel_joint" type="revolute">
        <origin xyz="1.0 -0.45 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <parent link="chassis"/>
        <child link="right_front_wheel"/>
        <limit effort="10" velocity="1.0" lower="-0.5" upper="0.5"/>
    </joint>

    <link name="right_front_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.2" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.2" length="0.1"/>
            </geometry>
            <material name="blue"/>
        </collision>
        <xacro:inertial_cylinder mass="1" length="0.1" radius="0.2">
            <origin xyz="0 0 0" rpy= "0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

</robot>