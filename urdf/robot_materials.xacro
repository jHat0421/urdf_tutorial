<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Define materials with names and properties -->
  
  <xacro:macro name="red_material" >
    <material name="red">
      <color rgba="1 0 0 1"/>  <!-- Red color -->
    </material>
  </xacro:macro>
  
  <xacro:macro name="blue_material" >
    <material name="blue">
      <color rgba="0 0 1 1"/>  <!-- Blue color -->
    </material>
  </xacro:macro>

  <xacro:macro name="green_material" >
    <material name="green">
      <color rgba="0 1 0 1"/>  <!-- Green color -->
    </material>
  </xacro:macro>

  <xacro:macro name="white_material" >
    <material name="white">
      <color rgba="1 1 1 1"/>  <!-- White color -->
    </material>
  </xacro:macro>

    <xacro:macro name="black_material" >
    <material name="black">
      <color rgba="0 0 0 1"/>  <!-- Black color -->
    </material>
  </xacro:macro>
</robot>
